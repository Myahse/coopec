server {
    listen 8010;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml;

    # Proxy API — même origine navigateur ; en-têtes backend comme vite.config / api/proxy.ts
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;

        proxy_connect_timeout 15s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
        proxy_buffering off;

        proxy_ssl_server_name on;
        proxy_ssl_verify off;

        proxy_set_header Host ${API_UPSTREAM_HOST};
        proxy_set_header Origin ${API_PUBLIC_ORIGIN};
        proxy_set_header Referer ${API_PUBLIC_ORIGIN}/;
        proxy_set_header X-Requested-With "XMLHttpRequest";
        proxy_set_header Accept $http_accept;
        proxy_set_header Content-Type $http_content_type;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Auth-Token $http_x_auth_token;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";

        proxy_cookie_domain ${API_UPSTREAM_HOST} $host;
        proxy_cookie_path / /;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2)$ {
        expires 7d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }
}
